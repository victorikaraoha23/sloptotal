# ─────────────────────────────────────────────────────────────────────────────
# SlopTotal frontend — Vercel environment variables
# Copy this file to `.env.local` for local dev, and set the SAME keys in the
# Vercel dashboard (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# MODE A (recommended): same-origin proxy. The browser calls YOUR Vercel origin;
# Vercel rewrites /api/* and /health to Render server-side (see next.config.mjs).
# This sidesteps the backend's CORS allow-list entirely — no Render change needed.
#   • Set this SERVER-ONLY var on Vercel (do NOT prefix with NEXT_PUBLIC_):
RENDER_BACKEND_URL=https://your-render-app.onrender.com

#   • Leave NEXT_PUBLIC_API_URL EMPTY / unset for Mode A.

# MODE B: call Render directly from the browser.
#   • Set the public base URL of your Render app:
NEXT_PUBLIC_API_URL=
#   • AND add your Vercel origin to CORSMiddleware.allow_origin_regex in
#     app/main.py on the backend, then redeploy Render. Otherwise the browser
#     blocks the response (CORS).

# Optional: link used by the header "GitHub" button.
NEXT_PUBLIC_GITHUB_URL=https://github.com/pablocaeg/sloptotal
